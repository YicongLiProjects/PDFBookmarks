<Page x:Class="PDFBookmarks.NotesEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDFBookmarks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NotesEditor">

    <Grid Background="White">
        <Button
        Width="65" VerticalAlignment="Top" Margin="72,32,0,0" Height="65" HorizontalAlignment="Left" FontSize="25" Foreground="Black" Content="" BorderBrush="{x:Null}">
            <Button.Background
        >
                <ImageBrush
        ImageSource="/assets/left-arrow.png"/>
            </Button.Background>
        </Button>
        <Label Content="Note editor" HorizontalAlignment="Left" Height="47" Margin="631,32,0,0" VerticalAlignment="Top" Width="135" FontSize="24"/>
        <Button Content="Save" HorizontalAlignment="Left" Height="63" Margin="72,354,0,0" VerticalAlignment="Top" Width="169" FontSize="30"/>
        <ScrollViewer HorizontalAlignment="Left" Height="320" Margin="325,97,0,0" VerticalAlignment="Top" Width="441">
            <RichTextBox Height="320" Width="421">
                <FlowDocument>
                    <Paragraph>
                        <Run Text="RichTextBox"/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>

        </ScrollViewer>
        <Button Content="" HorizontalAlignment="Left" Height="65" Margin="40,20,0,0" VerticalAlignment="Top" Width="65" FontSize="25" Foreground="Black" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="/assets/left-arrow.png"/>
            </Button.Background>
        </Button>
    </Grid>
</Page>
