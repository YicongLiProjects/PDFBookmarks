<Page x:Class="PDFBookmarks.FileEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDFBookmarks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FileEditor" Background="White">

    <Grid>
        <Menu HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" Width="800">

            <MenuItem FontSize="20" Header="Settings" Margin="38,0,0,0"/>
            <MenuItem FontSize="20" Header="Help"/>

        </Menu>
        <ScrollViewer HorizontalAlignment="Left" Height="342" Margin="207,45,0,0" VerticalAlignment="Top" Width="570"/>
        <Button Content="Add" HorizontalAlignment="Left" Height="43" Margin="38,45,0,0" VerticalAlignment="Top" Width="117" FontSize="20"/>
        <Button Content="Remove" HorizontalAlignment="Left" Height="42" Margin="38,120,0,0" VerticalAlignment="Top" Width="117" FontSize="20"/>
        <Button Content="Edit" HorizontalAlignment="Left" Height="43" Margin="38,194,0,0" VerticalAlignment="Top" Width="117" FontSize="20"/>
        <Label Content="Page" HorizontalAlignment="Left" Height="30" Margin="532,400,0,0" VerticalAlignment="Top" Width="46" FontSize="15" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="596,400,0,0" TextWrapping="Wrap" Text="count" VerticalAlignment="Top" Width="64" FontSize="16"/>
        <Label Content="/" HorizontalAlignment="Left" Height="30" Margin="680,400,0,0" VerticalAlignment="Top" Width="19" FontSize="16"/>
        <Label Content="Total" HorizontalAlignment="Left" Height="30" Margin="717,400,0,0" VerticalAlignment="Top" Width="60" FontSize="16"/>
    </Grid>
</Page>
