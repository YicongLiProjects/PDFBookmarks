<Page x:Class="PDFBookmarks.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDFBookmarks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsMenu">

    <Grid Background="White">
        <Label Content="Settings" HorizontalAlignment="Left" Height="66" Margin="40,85,0,0" VerticalAlignment="Top" Width="156" FontSize="40"/>
        <Label HorizontalAlignment="Left" Height="37" Margin="40,160,0,0" VerticalAlignment="Top" Width="156" FontSize="20">
            <TextBlock TextDecorations="Underline">Themes</TextBlock>
        </Label>
        <Label HorizontalAlignment="Left" Height="37" Margin="40,275,0,0" VerticalAlignment="Top" Width="156" FontSize="20">
            <TextBlock TextDecorations="Underline">Default folder</TextBlock>
        </Label>
        <RadioButton Content="Default" HorizontalAlignment="Left" Height="15" Margin="40,210,0,0" VerticalAlignment="Top" Width="64"/>
        <RadioButton Content="Desert" HorizontalAlignment="Left" Height="15" Margin="196,210,0,0" VerticalAlignment="Top" Width="62"/>
        <RadioButton Content="Future" HorizontalAlignment="Left" Height="15" Margin="326,210,0,0" VerticalAlignment="Top" Width="61" Checked="RadioButton_Checked"/>
        <TextBox HorizontalAlignment="Left" Height="21" Margin="45,329,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="316"/>
        <Button Content="Open folder" HorizontalAlignment="Left" Height="21" Margin="387,329,0,0" VerticalAlignment="Top" Width="85"/>
        <Button Content="" HorizontalAlignment="Left" Height="50" Margin="40,20,0,0" VerticalAlignment="Top" Width="50" Click="Button_Click" BorderBrush="{x:Null}">
            <Button.Background>
                <ImageBrush ImageSource="/left-arrow.png"/>
            </Button.Background>
        </Button>
    </Grid>
</Page>
